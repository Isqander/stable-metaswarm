# Read-only reference clones of analysed projects.
# Not submodules: throwaway shallow clones, restored by scripts/sync-refs.ps1
# from refs/manifest.tsv (committed) at the SHAs in refs/pinned.tsv (committed).
/refs/*
!/refs/manifest.tsv
!/refs/pinned.tsv

# JetBrains
/.idea/

# Python bytecode generated while validating executable fixtures.
__pycache__/
*.py[cod]

# Local Python project state and build output.
/.venv/
/.pytest_cache/
/.ruff_cache/
*.egg-info/
build/
dist/
